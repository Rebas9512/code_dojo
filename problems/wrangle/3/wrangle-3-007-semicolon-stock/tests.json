          5
        ]
      }
    }
  ],
  "hidden": [
    {
      "args": [
        "shelf;stock\n"
      ],
      "expected": {
        "name": "stock",
        "data": []
      }
    },
    {
      "args": [
        "shelf;stock\nA;0\nA;0\n"
      ],
      "expected": {
        "name": "stock",
        "data": [
          0,
          0
        ]
      }
    },
    {
      "args": [
        "shelf;stock\nC;12\nB;4\n"
      ],
      "expected": {
        "name": "stock",
        "data": [
          12,
          4
        ]
      }
    }
  ]
