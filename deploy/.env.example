# 复制为 deploy/.env，由 run.sh 按 Bash 语法读取。相对路径以项目根目录为准。
# CODE_DOJO_ENV_FILE 在启动脚本前指定，可指向另一份私有配置；默认 deploy/.env。
# 生产脚本只允许 on。直接启动开发后端的默认值为 off。
CODE_DOJO_AUTH=on
# 私有数据目录，存做题记录、密码哈希与各设备的会话。
CODE_DOJO_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/code-dojo"
# 默认读数据目录下的 auth.json。也可以粘贴其中 password_hash 的完整值，单引号保留 $。
# CODE_DOJO_PASSWORD_HASH='<完整密码哈希>'
CODE_DOJO_SESSION_DAYS=30
# 仅监听 127.0.0.1。改端口时同步修改 Tunnel 的 service 地址。
CODE_DOJO_PORT=8001
# 生产静态文件目录。开发后端默认不托管前端。
CODE_DOJO_WEB_DIST=web/dist
# 题库目录。省略时使用项目内的 problems/。
# CODE_DOJO_PROBLEMS=problems

# Python 判题容器镜像、本机 Docker 可挂载的临时目录、同时运行的容器数。
CODE_DOJO_JUDGE_IMAGE=code-dojo-judge-py:3.14
CODE_DOJO_JUDGE_TMP=/tmp/code-dojo-judge
CODE_DOJO_JUDGE_CONCURRENCY=2
# 数据科学题的镜像、容器内存与默认单用例时限（毫秒）。
CODE_DOJO_DS_IMAGE=code-dojo-judge-ds:3.14
CODE_DOJO_DS_MEMORY=1g
CODE_DOJO_DS_TIME_LIMIT_MS=10000

# 先用 off 试运行，配置本人访问权限后可以改为 claude。
CODE_DOJO_AI_PROVIDER=off
# 可填 Claude Code 可执行文件的绝对路径。其余命令在服务的 PATH 中查找。
CODE_DOJO_CLAUDE_BIN=claude
CODE_DOJO_AI_MODEL=claude-opus-5-5
CODE_DOJO_AI_EFFORT=low
# AI 子进程专用的空工作目录。
CODE_DOJO_AI_WORKDIR=/tmp/code-dojo-ai
# VPS 无桌面登录时才填，值由本人运行 claude setup-token 取得。
# CLAUDE_CODE_OAUTH_TOKEN='<订阅登录令牌>'

# 仅供 Vite 开发代理使用，生产前端直接请求同源 /api。
# CODE_DOJO_API=http://127.0.0.1:8000
# 题库校验内部标志，verify_python.py 重启到项目 Python 后自动置 1。
# CODE_DOJO_NO_REEXEC=1
